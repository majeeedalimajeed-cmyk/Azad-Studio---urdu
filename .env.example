# AZAD STUDIO — example environment. Never put real tokens in this file.
# Mount secrets as files or inject environment variables from a secret manager.

# Safety: keep all three false until launch approval.
NR_DRY_RUN=true
NR_PUBLISH_ENABLED=false
NR_PUBLISH_SAFETY_OK=false
NR_OPERATOR_APPROVED=false
NR_VERIFY_APPROVED=false
NR_AUTO_APPROVE_VERIFIED=false
NR_VIDEO_ENABLED=false

# Operator must supply the exact Page name shown by Meta's API.
NR_EXPECTED_PAGE_NAME=
NR_GRAPH_API_VERSION=v26.0
# The Page URL is hard-coded in config.py to the single authorized destination.

# Secret file paths (Docker/Kubernetes/systemd secret mounts). Do not set token values here.
NR_LLM_API_KEY_FILE=/run/secrets/nr_llm_api_key
NR_FB_USER_ACCESS_TOKEN_FILE=/run/secrets/nr_fb_user_token
NR_FB_PAGE_ACCESS_TOKEN_FILE=/run/secrets/nr_fb_page_token
NR_ADMIN_TOKEN_FILE=/run/secrets/nr_admin_token

# OpenAI-compatible model gateway. Agent A, Agent C and the independent translation
# reviewer can use separate models, implementing distinct agent roles.
NR_LLM_API_BASE=https://api.openai.com/v1
NR_LLM_MODEL=
NR_ROMAN_URDU_MODEL=
NR_VALIDATOR_MODEL=

# Scheduler (Asia/Kolkata).
NR_HOURLY_MINUTES=60
NR_BREAKING_MINUTES=5
NR_MORNING_HOUR_IST=7
NR_MAX_STORY_AGE_HOURS=36
NR_BREAKING_AGE_MINUTES=25

# Polite source fetching.
NR_HTTP_TIMEOUT=20
NR_MIN_REQUEST_INTERVAL=2.0

# Service.
NR_PORT=8000
