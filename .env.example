# AZAD STUDIO — example environment. Never put real token values in this file.
# Mount secrets as 600-permission files or inject env vars from a secret manager.

# Safety: keep all publishing flags false until launch approval.
NR_DRY_RUN=true
NR_PUBLISH_ENABLED=false
NR_PUBLISH_SAFETY_OK=false
NR_OPERATOR_APPROVED=false
NR_VERIFY_APPROVED=false
NR_AUTO_APPROVE_VERIFIED=false
NR_AUTO_POST_ENABLED=false
NR_VIDEO_ENABLED=false

# Facebook Page identity. The Page URL is hard-coded in config.py as a lookup
# hint; the API-confirmed Page ID below is the actual publishing target.
NR_GRAPH_API_VERSION=v26.0
NR_EXPECTED_PAGE_NAME=
NR_FB_PAGE_ID=

# Secret file paths. GitHub Actions maps these from repository secrets instead.
NR_FB_USER_ACCESS_TOKEN_FILE=/run/secrets/fb_user_token
NR_FB_PAGE_ACCESS_TOKEN_FILE=/run/secrets/fb_page_token
NR_ADMIN_TOKEN_FILE=/run/secrets/admin_token

# OpenAI-compatible model gateway. GROK_API_KEY and OPENAI_API_KEY are accepted
# as direct secret-name aliases; *_FILE variants are also supported.
# xAI Grok uses https://api.x.ai/v1 and grok-4.7; the reviewer can use grok-4.6.
NR_LLM_API_BASE=https://api.x.ai/v1
NR_LLM_MODEL=grok-4.7
NR_ROMAN_URDU_MODEL=grok-4.7
NR_VALIDATOR_MODEL=grok-4.6
NR_LLM_API_KEY_FILE=/run/secrets/llm_api_key
# GROK_API_KEY_FILE=/run/secrets/grok_api_key
# OPENAI_API_KEY_FILE=/run/secrets/openai_api_key

# Pixabay Content License stock photos. GitHub Actions maps PIXABAY_API_KEY to
# NR_PIXABAY_API_KEY; do not place the key in source. Images are downloaded
# locally, cached for 24 hours, credited, and never hotlinked.
NR_PIXABAY_API_KEY_FILE=/run/secrets/pixabay_api_key
# PIXABAY_API_KEY_FILE=/run/secrets/pixabay_api_key
# NR_PIXABAY_API_KEY_FILE=/run/secrets/pixabay_api_key
NR_PIXABAY_ENABLED=true
NR_PIXABAY_PER_PAGE=3
NR_PIXABAY_MIN_WIDTH=800
NR_PIXABAY_MIN_HEIGHT=600
NR_PIXABAY_CACHE_TTL=86400
NR_MAX_PHOTOS_PER_CARD=2

# Scheduler (Asia/Kolkata).
NR_HOURLY_MINUTES=60
NR_BREAKING_MINUTES=5
NR_MORNING_HOUR_IST=7
NR_MAX_STORY_AGE_HOURS=36
NR_BREAKING_AGE_MINUTES=25

# Polite source fetching.
NR_HTTP_TIMEOUT=20
NR_MIN_REQUEST_INTERVAL=2.0

# Service.
NR_PORT=8000
